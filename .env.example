# PostgreSQL
POSTGRES_USER=okf
POSTGRES_PASSWORD=okfpassword
POSTGRES_DB=okf
POSTGRES_URL=postgres://okf:okfpassword@postgres:5432/okf?sslmode=disable

# Redis
REDIS_URL=redis://redis:6379

# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET_ORIGINALS=originals
MINIO_BUCKET_BUNDLES=bundles
MINIO_USE_SSL=false

# JWT (INSEGURO: solo para desarrollo local, cambiar en cualquier despliegue real)
JWT_SECRET=insecure-dev-jwt-secret-CHANGE-ME-in-production

# API
PORT=8080
GIN_MODE=release
